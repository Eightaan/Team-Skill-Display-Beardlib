			<option type="number" min="0" max="300" step="1" decimal_count="0" show_value="true" default_value="0" name="Skill_x"/>
			<option type="number" min="0" max="300" step="1" decimal_count="0" show_value="true" default_value="25" name="Skill_y"/>
		</options>
	</Options>
</mod>